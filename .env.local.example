# ============================================================
# 论坛环境变量示例（复制为 .env.local 或使用 tools/init_config.py 生成）
# 部署到 Vercel 时，将这些变量配置到 Project -> Settings -> Environment Variables
# ============================================================

# ---------- 数据库（二选一） ----------
# 数据库类型：turso | postgres
DB_TYPE=turso
# Turso：https://app.turso.tech 创建数据库后，在 Dashboard 中复制 URL 与 Token
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Postgres（可选，切换为 postgres 时使用）：
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------- GitHub OAuth ----------
# https://github.com/settings/developers -> New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ---------- NextAuth ----------
# 本地开发 URL；生产环境由 Vercel 自动注入
NEXTAUTH_URL=http://localhost:3000
# 会话签名密钥，可用 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" 生成
NEXTAUTH_SECRET=generate-a-random-secret

# ---------- 管理员 ----------
# 逗号分隔的 GitHub 登录名列表，匹配的用户自动获得管理员角色
ADMIN_GITHUB_IDS=octocat

# ---------- 站点（构建期注入，修改后需重新构建） ----------
NEXT_PUBLIC_SITE_NAME=知识论坛
NEXT_PUBLIC_SITE_DESCRIPTION=一个轻量级的知识技术论坛
